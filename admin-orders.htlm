<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Orders - TAGMEE</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<header>
    <div class="logo">TAGMEE ADMIN</div>
</header>

<section class="hero">
    <h1>Share Orders</h1>
    <p>Review all customer buy orders.</p>
</section>

<section class="companies">

<div class="card">
    <h2>Order #1001</h2>
    <p><strong>User:</strong> John Doe</p>
    <p><strong>Company:</strong> Tesla (TSLA)</p>
    <p><strong>Shares:</strong> 10</p>
    <p><strong>Total:</strong> $1,753.00</p>
    <p><strong>Status:</strong> Completed</p>
</div>

<div class="card">
    <h2>Order #1002</h2>
    <p><strong>User:</strong> Jane Smith</p>
    <p><strong>Company:</strong> Apple (AAPL)</p>
    <p><strong>Shares:</strong> 5</p>
    <p><strong>Total:</strong> $1,060.75</p>
    <p><strong>Status:</strong> Pending</p>

    <button>Approve</button>
    <button>Reject</button>
</div>

<div class="card">
    <h2>Order #1003</h2>
    <p><strong>User:</strong> Michael Brown</p>
    <p><strong>Company:</strong> Microsoft (MSFT)</p>
    <p><strong>Shares:</strong> 8</p>
    <p><strong>Total:</strong> $4,083.20</p>
    <p><strong>Status:</strong> Completed</p>
</div>

</section>

<script src="script.js"></script>

</body>
</html>
